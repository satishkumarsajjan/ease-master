{
  "name": "ease",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "node scripts/build-llms.mjs && next build",
    "start": "next start",
    "analyze": "ANALYZE=true pnpm build",
    "lint": "eslint",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "registry:public": "npx shadcn build",
    "build:registry:meta": "node scripts/build-registry-meta.mjs",
    "make:doc": "node scripts/create-doc.mjs",
    "llm": "node scripts/build-llms.mjs",
    "changeset": "npx changeset",
    "release": "changeset version",
    "beta:enter": "changeset pre enter beta",
    "beta:exit": "changeset pre exit",
    "doctor": "node scripts/doctor.mjs",
    "check:doctor": "node scripts/doctor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "setup": "node scripts/init-project.mjs",
    "remove-module": "node scripts/remove-module.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@next/third-parties": "^16.3.2",
    "@number-flow/react": "^0.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "^16.7.10",
    "fumadocs-mdx": "^14.2.11",
    "gsap": "^3.15.0",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.404.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.1.2",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "10.8.0",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    }
  }
}
